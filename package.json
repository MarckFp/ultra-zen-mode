{
  "name": "ultra-zen-mode",
  "version": "1.18.0",
  "description": "Obsidian plugin – distraction-free zen reading/writing mode",
  "main": "main.js",
  "scripts": {
    "dev": "tsx esbuild.config.ts --watch",
    "build": "tsc --noEmit --skipLibCheck && tsx esbuild.config.ts production",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "zen",
    "focus"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "obsidian": "^1.14.4",
    "prettier": "3.9.10",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
